# Telegram Bot — @BotFather থেকে নিন
BOT_TOKEN=your_telegram_bot_token_here

# Neon.tech ডেটাবেস — Neon dashboard > Connection Details থেকে কপি করুন
# (pooled connection - বট/API রানটাইমের জন্য)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# (unpooled/direct connection - Prisma migration চালানোর জন্য)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# AI (Gemini) API key — Q&A ফিচারের জন্য
# নিন এখান থেকে: https://aistudio.google.com/app/apikey (ফ্রি)
GEMINI_API_KEY=your_gemini_api_key_here

# ড্যাশবোর্ড API auth এর জন্য যেকোনো র‍্যান্ডম লম্বা স্ট্রিং
JWT_SECRET=change_this_to_a_long_random_string

# প্রথম অ্যাডমিন লগইন বানানোর জন্য এক-বারের গোপন key (setup এর পর এটা মুছে/বদলে ফেলুন)
ADMIN_SETUP_KEY=change_this_to_another_long_random_string

# Express API পোর্ট (Fly.io এটা নিজে সেট করে দেবে, লোকালে টেস্টের জন্য)
PORT=3000

# ড্যাশবোর্ড (Vercel) URL — CORS এর জন্য
DASHBOARD_URL=https://your-dashboard.vercel.app
